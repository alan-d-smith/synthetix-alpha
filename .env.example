# Copy to .env and fill in

ALPACA_API_KEY=
ALPACA_API_SECRET=

# The dedicated paper account the strategy is deployed on, kept separate from the research keys above so a
# stray script cannot trade it. Must be a fresh account: the hackathon requires an unused one at $100k.
ALPACA_DEPLOYED_API_KEY=
ALPACA_DEPLOYED_API_SECRET=

# Bitquery (https://bitquery.io) — on-chain DEX trades. v2 OAuth token, starts "ory_"
BITQUERY_TOKEN=

# Birdeye (https://birdeye.so) — Solana token and trader analytics
BIRDEYE=

# Finnhub (fundamentals, sentiment, news) — https://finnhub.io/register
FINNHUB_API_KEY=

# FRED (macroeconomic data, yield curves, stress indices) — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# OpenAI (LLM critic agent, pipeline orchestration) — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_BASE_URL=   # optional: custom endpoint (e.g. Azure, local)
# OPENAI_MODEL=gpt-4o-mini

# Deployment target. Kept out of the repo: this file is committed, .env is not.
# Prefer VPS_ALIAS with a matching Host block in ~/.ssh/config, so no address appears anywhere.
VPS_HOST=
VPS_USER=
VPS_ALIAS=
