# ============================================================
# Alpaca AI Trading Agents — Paper Trading (NO LIVE KEYS)
# Copy this file to .env and fill in your paper-trading values.
# NEVER commit .env or real API keys to version control.
# ============================================================

# Alpaca Trading API (paper only)
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_API_SECRET=your_paper_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# Finnhub (news / sentiment / earnings)
FINNHUB_API_KEY=your_finnhub_api_key_here

# FRED (macro data — optional, free tier)
FRED_API_KEY=your_fred_api_key_here

# LLM Provider (pick one)
LLM_PROVIDER=deepseek
FEATHERLESS_API_KEY=your_featherless_api_key_here
LLM_MODEL=deepseek-v4-pro

# Operational
LOG_LEVEL=INFO
PAPER_ONLY=true